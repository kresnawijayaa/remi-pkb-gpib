# Salin menjadi .env di VPS, bukan .env.local di laptop.
REMI_IMAGE=ghcr.io/kresnawijayaa/remi-pkb-gpib:latest
# Gunakan 64 karakter hex (openssl rand -hex 32) agar aman dipakai dalam URL.
POSTGRES_PASSWORD=
REMI_ADMIN_PIN=
# Pertahankan secret lama jika ingin sesi login yang ada tetap valid.
REMI_SESSION_SECRET=
